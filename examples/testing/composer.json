{
    "name": "tomaj/nette-auto-variable-template-example-testing",
    "description": "PHPUnit tests that check the registered variables of an application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "latte/latte": "^3.0",
        "nette/bootstrap": "^3.2",
        "tomaj/nette-auto-variable-template": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "tomaj/nette-auto-variable-template": "dev-master"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
