{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "build/infection.log",
        "html": "build/infection.html",
        "summary": "build/infection-summary.log",
        "json": "build/infection.json"
    },
    "mutators": {
        "@default": true,
        "AssignCoalesce": {
            "ignore": [
                // the per-class cache of acceptsAnyProperty(): computing it on every call gives the same result, only slower
                "Tomaj\\Latte\\AutoVariableTemplateFactory::assignVariables"
            ]
        }
    },
    "minMsi": 95,
    "minCoveredMsi": 95,
    "phpUnit": {
        "configDir": "."
    }
}
