{
    "name": "tomaj/nette-auto-variable-template",
    "description": "Nette template factory that assigns registered variables to every Latte template.",
    "license": "LGPL-2.0-or-later",
    "type": "library",
    "keywords": [
        "nette",
        "latte",
        "template",
        "variable",
        "global"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "homepage": "https://tomaj.github.io/nette-auto-variable-template/",
    "support": {
        "issues": "https://github.com/tomaj/nette-auto-variable-template/issues",
        "source": "https://github.com/tomaj/nette-auto-variable-template",
        "docs": "https://tomaj.github.io/nette-auto-variable-template/",
        "security": "https://github.com/tomaj/nette-auto-variable-template/security/policy"
    },
    "require": {
        "php": "^8.3",
        "nette/application": "^3.2",
        "nette/utils": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nette/phpstan-rules": "^1.0.8",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Tomaj\\Latte\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@lint"
        ],
        "cs-fix": "php-cs-fixer fix",
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G"
    }
}
